# Testing Environment
APP_NAME=vubatype-be
NODE_ENV=testing

# Test Database - PostgreSQL
DB_TYPE=postgres
DB_HOST=db-test
DB_PORT=5432
DB_NAME=vubatype-be_test
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_123


# Test Redis
REDIS_HOST=redis-test
REDIS_PORT=6379

# JWT for testing
JWT_SECRET=test-secret-key
JWT_EXPIRES_IN=1d

# API
API_PREFIX=api
API_VERSION=1

# Guest sessions
GUEST_SESSION_TTL_DAYS=7